{
    "name": "node-simdb",
    "description": "Node.js native addon — wrapper for SimDB, a high-performance shared-memory lock-free key-value store.",
    "version": "0.1.0",
    "contributors": [
        {
            "name": "Nicola Del Gobbo",
            "email": "nicoladelgobbo@gmail.com"
        },
        {
            "name": "Mauro Doganieri",
            "email": "mauro.doganieri@gmail.com"
        },
        {
            "name": "Pierluigi Iannarelli",
            "email": "pierluigi.ianarelli@gmail.com"
        }
    ],
    "keywords": [
        "simdb",
        "shared-memory",
        "key-value",
        "native",
        "addon",
        "napi"
    ],
    "license": "Apache-2.0",
    "scripts": {
        "install":  "node scripts/download-deps.js && node-gyp rebuild",
        "prebuild": "node scripts/download-deps.js && prebuildify --napi --strip",
        "test":     "node --test test/simdb.test.js",
        "build":    "node-gyp rebuild"
    },
    "engines": {
        "node": ">= 16.0.0"
    },
    "gypfile": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/NickNaso/node-simdb.git"
    },
    "bugs": {
        "url": "https://github.com/NickNaso/node-simdb/issues"
    },
    "homepage": "https://github.com/NickNaso/node-simdb",
    "main": "./index.js",
    "dependencies": {
        "node-addon-api": "^8.3.1",
        "node-gyp-build": "^4.8.4"
    },
    "devDependencies": {
        "node-gyp":    "^11.2.0",
        "prebuildify": "^6.0.1"
    }
}
